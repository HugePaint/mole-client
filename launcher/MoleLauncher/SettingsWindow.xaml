<Window x:Class="MoleLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="640" Width="720"
        Background="#FF1E1E1E" Foreground="#FFE6E6E6"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Lbl">
            <Setter Property="Foreground" Value="#FFB0B0B0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2D2D30" />
            <Setter Property="Foreground" Value="#FFE6E6E6" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,0,6,8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE6E6E6" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#FF9A9A9A" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FF2D2D30" />
            <Setter Property="Foreground" Value="#FFE6E6E6" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <GroupBox Header="路径">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="项目根目录" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtRoot" />
                        <Button Grid.Row="0" Grid.Column="2" Content="浏览…" Click="OnBrowseRoot" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="node.exe" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtNode" />
                        <Button Grid.Row="1" Grid.Column="2" Content="浏览…" Click="OnBrowseNode" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="ruffle.exe" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtRuffle" />
                        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                            <Button Content="浏览…" Click="OnBrowseRuffle" />
                            <Button Content="下载…" Click="OnDownloadRuffle"
                                    ToolTip="从 Ruffle 官方 GitHub Releases 下载 Windows x64 版到 runtime\ruffle\" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="镜像端口（需与 molemirror 环境变量一致）">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Lbl}" Text="正向代理" />
                        <TextBox x:Name="TxtProxyPort" Width="70" />
                        <TextBlock Style="{StaticResource Lbl}" Text="控制接口" Margin="10,0,10,0" />
                        <TextBox x:Name="TxtControlPort" Width="70" />
                        <TextBlock Style="{StaticResource Lbl}" Text="反向代理源站" Margin="10,0,10,0" />
                        <TextBox x:Name="TxtOriginPort" Width="70" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="运行模式">
                    <StackPanel>
                        <CheckBox x:Name="ChkUseProxy" Content="让 Ruffle 走本地镜像（关闭则直连官方 CDN）" />
                        <CheckBox x:Name="ChkOffline" Content="离线模式（镜像拒绝一切回源，用于验证资源本地化完整性）" />
                        <CheckBox x:Name="ChkAutoStart" Content="启动器打开时自动拉起本地镜像" />
                        <CheckBox x:Name="ChkMinimizeToTray" Content="关闭窗口时最小化到托盘（游戏继续运行）" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="画面">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Lbl}" Text="窗口宽度" />
                            <TextBox x:Name="TxtWidth" Width="70" />
                            <TextBlock Style="{StaticResource Lbl}" Text="高度" Margin="10,0,10,0" />
                            <TextBox x:Name="TxtHeight" Width="70" />
                            <TextBlock Style="{StaticResource Lbl}" Margin="12,0,0,0"
                                       Text="（客户端逻辑尺寸 960×560）" />
                        </StackPanel>
                        <CheckBox x:Name="ChkFullscreen" Content="全屏启动" />
                        <CheckBox x:Name="ChkNoGui" Content="隐藏 Ruffle 菜单栏（--no-gui）" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="高级">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Lbl}" HorizontalAlignment="Left"
                                   Text="追加给 Ruffle 的额外参数（空格分隔）" />
                        <TextBox x:Name="TxtExtra" />
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="恢复默认" Click="OnReset" />
            <Button Content="确定" Click="OnOk" Background="#FF2E7D32" BorderBrush="#FF3E9E43" />
            <Button Content="取消" Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
