<Window x:Class="MoleLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MoleLauncher"
        Title="摩尔庄园 · 本地客户端" Height="620" Width="880"
        MinHeight="480" MinWidth="720"
        Background="#FF1E1E1E" Foreground="#FFE6E6E6"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9A9A9A" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE6E6E6" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FF333333" />
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FF2D2D30" />
            <Setter Property="Foreground" Value="#FFE6E6E6" />
            <Setter Property="BorderBrush" Value="#FF3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#FF2E7D32" />
            <Setter Property="BorderBrush" Value="#FF3E9E43" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 状态 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="摩尔庄园 · 本地客户端" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,16,0" />
            <Border Style="{StaticResource Chip}" x:Name="ChipMirror">
                <TextBlock x:Name="TxtMirror" Text="镜像 ●" />
            </Border>
            <Border Style="{StaticResource Chip}" x:Name="ChipRuffle">
                <TextBlock x:Name="TxtRuffle" Text="游戏 ●" />
            </Border>
            <Border Style="{StaticResource Chip}" x:Name="ChipMode">
                <TextBlock x:Name="TxtMode" Text="在线" />
            </Border>
        </StackPanel>

        <!-- 统计 -->
        <Border Grid.Row="1" Background="#FF252526" CornerRadius="6" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource StatLabel}" Text="本地资源" />
                    <TextBlock x:Name="StatEntries" Style="{StaticResource StatValue}" Text="—" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource StatLabel}" Text="体积" />
                    <TextBlock x:Name="StatSize" Style="{StaticResource StatValue}" Text="—" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource StatLabel}" Text="请求 / 缓存命中" />
                    <TextBlock x:Name="StatRequests" Style="{StaticResource StatValue}" Text="—" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Style="{StaticResource StatLabel}" Text="命中率" />
                    <TextBlock x:Name="StatHit" Style="{StaticResource StatValue}" Text="—" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 按钮 -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
            <Button x:Name="BtnPlay" Style="{StaticResource BtnPrimary}" Content="▶  启动游戏"
                    Click="OnPlayClick" />
            <Button x:Name="BtnStop" Style="{StaticResource Btn}" Content="■  停止全部"
                    Click="OnStopClick" />
            <Button Style="{StaticResource Btn}" Content="设置…" Click="OnSettingsClick" />
            <Button Style="{StaticResource Btn}" Content="打开缓存目录" Click="OnOpenCacheClick" />
            <Button Style="{StaticResource Btn}" Content="打开日志" Click="OnOpenLogsClick" />
        </WrapPanel>

        <!-- 命令行预览 -->
        <Expander Grid.Row="3" Header="实际执行的 Ruffle 命令行" Foreground="#FF9A9A9A"
                  Margin="0,0,0,10">
            <TextBox x:Name="TxtCommand" IsReadOnly="True" TextWrapping="Wrap"
                     FontFamily="Consolas, monospace" FontSize="11"
                     Background="#FF1B1B1B" Foreground="#FFB0B0B0"
                     BorderBrush="#FF3F3F46" Padding="8" MinHeight="70" />
        </Expander>

        <!-- 日志 -->
        <Border Grid.Row="4" Background="#FF1B1B1B" CornerRadius="6" BorderBrush="#FF3F3F46"
                BorderThickness="1">
            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                     Foreground="#FFC8C8C8" FontFamily="Consolas, monospace" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True" ItemsSource="{Binding Logs}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="6,1" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" TextWrapping="NoWrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#FFC8C8C8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Ok">
                                            <Setter Property="Foreground" Value="#FF7DD87D" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Warn">
                                            <Setter Property="Foreground" Value="#FFE0C060" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                            <Setter Property="Foreground" Value="#FFE07070" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="5" x:Name="TxtHint" Margin="0,8,0,0"
                   Foreground="#FF8A8A8A" FontSize="11" TextWrapping="Wrap"
                   Text="提示：首次启动前，设置里确认「项目根目录」指向包含 molemirror 与 runtime\ruffle 的目录。" />
    </Grid>
</Window>
