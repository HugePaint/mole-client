# ══════════════════════════════════════════════════════════
#  摩尔庄园本地客户端 —— Git 忽略规则
# ══════════════════════════════════════════════════════════

# ── 按需求排除的共享素材 ──────────────────────────────────
52摩尔共享素材与数据/

# ── 官方游戏资源与逆向产物 ────────────────────────────────
# 版权归上海淘米，不属于本项目，不入库。
# 资源由 molemirror 在运行时按需从官方 CDN 抓取到 cache/。
cache/
assets-corpus/
_re/
_recon/

# ── 第三方二进制与引擎运行时 ──────────────────────────────
# Ruffle 有自己的许可证，且体积大；由启动器按需下载。
runtime/

# ── 运行期状态（含本机路径、日志、缓存索引）───────────────
data/
logs/

# ── 构建产物 ──────────────────────────────────────────────
[Bb]in/
[Oo]bj/
**/publish/
installer/build/
installer/MoleClient-Setup.exe
installer/~*.DDF
installer/*.DDF

# ── 编辑器 / 系统杂项 ─────────────────────────────────────
.vs/
.vscode/
.idea/
*.user
*.suo
*.log
*.pid
*.tmp
Thumbs.db
desktop.ini

# ── 本地工具（如下载来的 gh CLI），不入库 ─────────────────
.tools/
